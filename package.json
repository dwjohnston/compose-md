{
  "name": "compose-md-cli",
  "version": "0.1.0",
  "description": "A CLI for composing markdown agent context files (CLAUDE.md, AGENTS.md, etc.) from reusable fragments and YAML approach configs.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwjohnston/compose-md.git"
  },
  "main": "./dist/cli.js",
  "exports": "./dist/cli.js",
  "bin": {
    "compose": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "compose": "bun run src/cli.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R src/startingPrompts dist/startingPrompts && chmod +x dist/cli.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf projectDocs && git checkout -- .gitignore",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5",
    "vitepress": "^2.0.0-alpha.18"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "js-yaml": "^5.2.0"
  }
}